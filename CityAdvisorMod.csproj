<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>CityAdvisorMod</AssemblyName>
    <RootNamespace>CityAdvisor</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!--
      Path to the game's Managed assemblies folder, needed to compile
      against ICities/ColossalFramework/Assembly-CSharp. Override by setting
      the CS1_MANAGED_PATH environment variable rather than editing this
      file, since the correct path is machine-specific. See README.md.
    -->
    <CS1ManagedPath Condition="'$(CS1_MANAGED_PATH)' != ''">$(CS1_MANAGED_PATH)</CS1ManagedPath>
    <CS1ManagedPath Condition="'$(CS1ManagedPath)' == '' AND '$(OS)' != 'Windows_NT'">$(HOME)/Library/Application Support/Steam/steamapps/common/Cities_Skylines/Cities.app/Contents/Resources/Data/Managed</CS1ManagedPath>
    <CS1ManagedPath Condition="'$(CS1ManagedPath)' == '' AND '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\Cities_Skylines\Cities_Data\Managed</CS1ManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin/**" />
    <Compile Remove="obj/**" />
    <!--
      tests/ is its own project (CityAdvisor.Tests.csproj) that links in
      individual game-independent source files by path, so exclude it here:
      this project's default **/*.cs globbing would otherwise also try to
      compile xunit test files against a project with no xunit reference.
    -->
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ICities">
      <HintPath>$(CS1ManagedPath)/ICities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(CS1ManagedPath)/ColossalManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(CS1ManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CS1ManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Harmony: CitiesHarmony.API transitively brings its own compile-time
    Harmony assembly (CitiesHarmony.Harmony). A separate direct
    Lib.Harmony reference was tried first and rejected: NuGet resolved
    both, and they defined conflicting duplicate HarmonyLib types (CS0433).
    CitiesHarmony.API alone is sufficient to compile against HarmonyLib's
    attributes/Harmony class. At runtime, mods using this pattern share a
    single copy of Harmony provided by the "Harmony (Mod Dependency)"
    Workshop item (boformer/CitiesHarmony), e.g. Traffic Manager:
    President Edition already requires it, rather than each mod bundling
    its own.
  -->
  <ItemGroup>
    <PackageReference Include="CitiesHarmony.API" Version="2.2.0" />
  </ItemGroup>

</Project>
