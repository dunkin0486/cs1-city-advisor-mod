<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    Deliberately has NO reference to the CS1 game assemblies
    (ICities/ColossalManaged/Assembly-CSharp/UnityEngine) and no
    ProjectReference to CityAdvisorMod.csproj, which requires them. This
    project only compiles the game-independent source files it links in
    below, so `dotnet test` runs in CI without a licensed game install.
    See CONTRIBUTING.md for what is and isn't covered by this.
  -->
  <ItemGroup>
    <Compile Include="../src/MissingInterchangeScoring.cs" Link="MissingInterchangeScoring.cs" />
    <Compile Include="../src/LocationDescription.cs" Link="LocationDescription.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
